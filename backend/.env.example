# Local service configuration. backend/.env is excluded from version control.
# Business Coach: create a key at https://aistudio.google.com/apikey
# Keep this key on the server, never in a VITE_ variable.
GEMINI_API_KEY=
ADVISOR_MODEL=gemini-3.5-flash-lite
# Existing LLM_API_KEY is also accepted by Business Coach when GEMINI_API_KEY is empty.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional. Main model, then fallbacks tried in order when it errors or hits its free-tier quota.
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# Telegram bot token from @BotFather (/newbot or /revoke). Never commit it.
TELEGRAM_TOKEN=
